# Windows Remote Admin 环境变量样例
# 复制为 .env（与本文件同目录，即程序根目录）后生效。
# npm run dev / npm start / Run.cmd / NSSM 服务均会自动加载程序目录下的 .env；
# 已存在的环境变量（如 NSSM AppEnvironmentExtra 注入）优先于 .env。

# 监听端口
WRA_PORT=12306

# 会话签名密钥：64 位 hex 或至少 32 字符字符串
# 缺省时自动生成并持久化到 data/.session-key
#WRA_SESSION_SECRET=

# PowerShell 命令执行超时（毫秒）
WRA_PS_TIMEOUT=60000

# 单文件上传上限（MB）
WRA_UPLOAD_MAX_MB=100

# 文件读取/编辑上限（MB）
WRA_READ_MAX_MB=10

# zip 解压总大小上限（MB）
WRA_EXTRACT_MAX_MB=2048

# zip 解压条目数上限
WRA_EXTRACT_MAX_FILES=20000

# 是否允许"系统程序打开"（默认禁用，开启后将在服务器桌面会话中启动程序）
WRA_ENABLE_SERVER_OPEN=false

# 允许访问的路径前缀白名单，用 | 或 ; 分隔，留空表示不限制
#WRA_PATH_WHITELIST=C:\data|D:\logs

# 日志保留天数（按天轮转）
WRA_LOG_RETENTION=30
