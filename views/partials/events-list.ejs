<%# 事件列表片段（筛选/搜索后整块刷新；locals: rows, total, msg, maxEvents） %>
<% const lvlMap = { 1: ['events.lvlCritical', 'bg-red-lt'], 2: ['events.lvlError', 'bg-red-lt'], 3: ['events.lvlWarning', 'bg-warning-lt'], 4: ['events.lvlInfo', 'bg-azure-lt'], 5: ['events.lvlVerbose', 'bg-secondary-lt'] }; %>
<% if (msg) { %>
<div class="alert alert-danger alert-dismissible m-2 mb-0" role="alert">
  <i class="ti ti-alert-triangle me-1"></i><%= msg %>
</div>
<% } %>

<div class="d-flex flex-wrap gap-2 align-items-center px-3 pt-3">
  <span class="badge bg-secondary-lt"><%= t('events.statTotal').replace('{n}', total) %></span>
  <span class="badge bg-azure-lt"><%= t('events.hintMax').replace('{n}', maxEvents) %></span>
</div>

<div class="table-responsive">
  <table class="table table-hover table-vcenter card-table">
    <thead>
      <tr>
        <th style="width:15%"><%= t('events.colTime') %></th>
        <th style="width:9%"><%= t('events.colLevel') %></th>
        <th style="width:16%"><%= t('events.colSource') %></th>
        <th style="width:7%"><%= t('events.colEventId') %></th>
        <th><%= t('events.colMessage') %></th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
      <tr><td colspan="5" class="text-center text-secondary py-4"><%= t('events.noEvents') %></td></tr>
      <% } %>
      <% rows.forEach(function (row) {
        const lvl = lvlMap[row.l] || lvlMap[5];
      %>
      <tr>
        <td class="font-monospace text-truncate"><%= row.t %></td>
        <td><span class="badge <%= lvl[1] %>"><%= t(lvl[0]) %></span></td>
        <td class="text-truncate" title="<%= row.p || '' %>"><%= row.p || '-' %></td>
        <td class="font-monospace"><%= row.i %></td>
        <td class="text-truncate" title="<%= row.m || '' %>"><%= row.m || '-' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
