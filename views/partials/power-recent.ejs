<div class="card">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-history me-2"></i><%= t('p.recentTitle') %></h3>
  </div>
  <div class="card-body py-2">
    <% if (err) { %>
    <div class="alert alert-warning mb-0"><%= err %></div>
    <% } else if (!rows || !rows.length) { %>
    <div class="text-secondary py-1"><%= t('p.recentEmpty') %></div>
    <% } else { %>
    <div class="list-group list-group-flush">
      <% rows.forEach(function (r) { %>
      <div class="list-group-item px-0 py-2">
        <span class="badge bg-blue-lt me-2 font-monospace"><%= r.time %></span>
        <span class="small"><%= r.msg %></span>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>
