<%# 用户列表片段（搜索/操作后整块刷新；locals: rows, total, msg, kw） %>
<% if (msg) { %>
<div class="alert alert-danger alert-dismissible m-2 mb-0" role="alert">
  <i class="ti ti-alert-triangle me-1"></i><%= msg %>
</div>
<% } %>

<div class="d-flex flex-wrap gap-2 align-items-center px-3 pt-3">
  <span class="badge bg-secondary-lt"><%= t('users.statTotal').replace('{n}', total) %></span>
</div>

<div class="table-responsive">
  <table class="table table-hover table-vcenter card-table">
    <thead>
      <tr>
        <th><%= t('users.colAccount') %></th>
        <th style="width:13%"><%= t('users.colStatus') %></th>
        <th style="width:15%"><%= t('users.colLastLogon') %></th>
        <th style="width:15%"><%= t('users.colPwdSet') %></th>
        <% if (role !== 'readonly') { %>
        <th style="width:22%" class="text-end"><%= t('users.colActions') %></th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
      <tr><td colspan="5" class="text-center text-secondary py-4"><%= t('users.noRows') %></td></tr>
      <% } %>
      <% rows.forEach(function (u) { %>
      <tr>
        <td>
          <div class="d-flex align-items-center text-truncate">
            <i class="ti ti-user <%= u.e ? 'text-success' : 'text-secondary' %> me-2"></i>
            <div class="text-truncate">
              <div class="text-truncate font-monospace"><%= u.n %></div>
              <% if (u.d) { %><div class="small text-secondary text-truncate"><%= u.d %></div><% } %>
            </div>
          </div>
        </td>
        <td>
          <span class="badge <%= u.e ? 'bg-success-lt' : 'bg-secondary-lt' %>"><%= u.e ? t('users.enabled') : t('users.disabled') %></span>
          <% if (u.lo) { %><span class="badge bg-red-lt"><%= t('users.locked') %></span><% } %>
        </td>
        <td class="small font-monospace text-truncate"><%= u.ll || '-' %></td>
        <td class="small font-monospace text-truncate"><%= u.pl || '-' %></td>
        <% if (role !== 'readonly') { %>
        <td class="text-end">
          <div class="btn-group btn-group-sm" role="group">
            <% if (u.lo) { %>
            <button class="btn btn-outline-warning user-act" title="<%= t('users.unlock') %>" data-name="<%= u.n %>" data-action="unlock">
              <i class="ti ti-lock-open"></i>
            </button>
            <% } %>
            <% if (!u.e && u.n !== 'Guest') { %>
            <button class="btn btn-outline-success user-act" title="<%= t('users.enable') %>" data-name="<%= u.n %>" data-action="enable">
              <i class="ti ti-user-check"></i>
            </button>
            <% } %>
            <button class="btn btn-outline-azure user-pwd" title="<%= t('users.resetPwd') %>" data-name="<%= u.n %>">
              <i class="ti ti-key"></i>
            </button>
          </div>
        </td>
        <% } %>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
