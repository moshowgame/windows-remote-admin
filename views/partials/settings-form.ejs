<%# 设置主区内容（locals: quickAccess, readonly） %>
<% const ro = readonly === true || role === 'readonly'; %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="ti ti-bookmarks me-1"></i>快速访问</h3>
        <div class="card-subtitle">显示在「文件资源管理器」侧边栏，保存到 config.json</div>
      </div>
      <div class="card-body">
        <% if (ro) { %>
        <div class="alert alert-warning mb-0 py-2 text-center">
          <i class="ti ti-lock me-1"></i>当前为<strong>只读账号</strong>，设置仅可查看
        </div>
        <div class="list-group list-group-flush mt-2">
          <% for (const qa of quickAccess) { %>
          <div class="list-group-item px-2 py-1 text-truncate font-monospace">
            <i class="ti ti-folder me-1 text-warning"></i><%= qa.label || qa.path %>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <form id="qa-form" hx-post="/settings/quick-access" hx-swap="none">
          <div id="qa-rows">
            <% if (!quickAccess || quickAccess.length === 0) { %>
              <%# 无配置时给一行空行 %>
              <div class="row g-2 mb-2 qa-row">
                <div class="col-4"><input name="label" class="form-control" placeholder="名称" maxlength="50"></div>
                <div class="col-7"><input name="path" class="form-control font-monospace" placeholder="例如 C:\data" spellcheck="false"></div>
                <div class="col-1"><button type="button" class="btn btn-ghost-danger w-100 qa-del" title="删除此行"><i class="ti ti-x"></i></button></div>
              </div>
            <% } %>
            <% for (const qa of quickAccess) { %>
              <div class="row g-2 mb-2 qa-row">
                <div class="col-4"><input name="label" class="form-control" value="<%= qa.label %>" maxlength="50"></div>
                <div class="col-7"><input name="path" class="form-control font-monospace" value="<%= qa.path %>" spellcheck="false"></div>
                <div class="col-1"><button type="button" class="btn btn-ghost-danger w-100 qa-del" title="删除此行"><i class="ti ti-x"></i></button></div>
              </div>
            <% } %>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="qa-add">
              <i class="ti ti-plus me-1"></i>添加一行
            </button>
            <button type="submit" class="btn btn-primary btn-sm ms-auto">
              <i class="ti ti-device-floppy me-1"></i>保存
            </button>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="ti ti-adjustments me-1"></i>系统参数（只读）</h3>
        <div class="card-subtitle">通过 config.json 或 WRA_* 环境变量调整，重启生效</div>
      </div>
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-6">服务端口</dt><dd class="col-6"><%= readonly.port %></dd>
          <dt class="col-6">命令超时</dt><dd class="col-6"><%= Math.round(readonly.psTimeoutMs / 1000) %>s</dd>
          <dt class="col-6">上传单文件上限</dt><dd class="col-6"><%= readonly.uploadMaxMb %> MB</dd>
          <dt class="col-6">读取/编辑上限</dt><dd class="col-6"><%= readonly.readMaxMb %> MB</dd>
          <dt class="col-6">预览每页行数</dt><dd class="col-6"><%= readonly.previewPageLines %> 行</dd>
          <dt class="col-6">解压总量上限</dt><dd class="col-6"><%= readonly.extractMaxMb %> MB</dd>
          <dt class="col-6">解压条目上限</dt><dd class="col-6"><%= readonly.extractMaxFiles %> 项</dd>
          <dt class="col-6">服务器直接打开</dt>
          <dd class="col-6">
            <% if (readonly.enableServerOpen) { %><span class="badge bg-warning-lt">已启用</span><% } else { %><span class="badge bg-secondary-lt">已禁用</span><% } %>
          </dd>
          <dt class="col-6">日志保留天数</dt><dd class="col-6"><%= readonly.logRetentionDays %> 天</dd>
        </dl>
      </div>
      <div class="card-footer">
        <div class="small text-secondary mb-1">
          <i class="ti ti-shield-lock me-1"></i>路径白名单
          <% if (readonly.pathWhitelist.length === 0) { %>
            <span class="badge bg-secondary-lt ms-1">未启用（可访问全盘）</span>
          <% } %>
        </div>
        <% for (const w of readonly.pathWhitelist) { %>
          <div class="small font-monospace text-break"><i class="ti ti-point me-1"></i><%= w %></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
