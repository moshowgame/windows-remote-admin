<%# 设置主区内容（locals: quickAccess, readonly） %>
<% const ro = readonly === true || role === 'readonly'; %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="ti ti-bookmarks me-1"></i><%= t('settings.qaTitle') %></h3>
        <div class="card-subtitle"><%= t('settings.qaSubtitle') %></div>
      </div>
      <div class="card-body">
        <% if (ro) { %>
        <div class="alert alert-warning mb-0 py-2 text-center">
          <i class="ti ti-lock me-1"></i><%- t('settings.readonlyNotice') %>
        </div>
        <div class="list-group list-group-flush mt-2">
          <% for (const qa of quickAccess) { %>
          <div class="list-group-item px-2 py-1 text-truncate font-monospace">
            <i class="ti ti-folder me-1 text-warning"></i><%= qa.label || qa.path %>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <form id="qa-form" hx-post="/settings/quick-access" hx-swap="none">
          <div id="qa-rows">
            <% if (!quickAccess || quickAccess.length === 0) { %>
              <%# 无配置时给一行空行 %>
              <div class="row g-2 mb-2 qa-row">
                <div class="col-4"><input name="label" class="form-control" placeholder="<%= t('settings.qaNamePlaceholder') %>" maxlength="50"></div>
                <div class="col-7"><input name="path" class="form-control font-monospace" placeholder="<%= t('settings.qaPathPlaceholder') %>" spellcheck="false"></div>
                <div class="col-1"><button type="button" class="btn btn-ghost-danger w-100 qa-del" title="<%= t('settings.qaDeleteRow') %>"><i class="ti ti-x"></i></button></div>
              </div>
            <% } %>
            <% for (const qa of quickAccess) { %>
              <div class="row g-2 mb-2 qa-row">
                <div class="col-4"><input name="label" class="form-control" value="<%= qa.label %>" maxlength="50"></div>
                <div class="col-7"><input name="path" class="form-control font-monospace" value="<%= qa.path %>" spellcheck="false"></div>
                <div class="col-1"><button type="button" class="btn btn-ghost-danger w-100 qa-del" title="<%= t('settings.qaDeleteRow') %>"><i class="ti ti-x"></i></button></div>
              </div>
            <% } %>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="qa-add">
              <i class="ti ti-plus me-1"></i><%= t('settings.qaAddRow') %>
            </button>
            <button type="submit" class="btn btn-primary btn-sm ms-auto">
              <i class="ti ti-device-floppy me-1"></i><%= t('settings.save') %>
            </button>
          </div>
        </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><i class="ti ti-adjustments me-1"></i><%= t('settings.sysTitle') %></h3>
        <div class="card-subtitle"><%= t('settings.sysSubtitle') %></div>
      </div>
      <div class="card-body">
        <dl class="row mb-0 small">
          <dt class="col-6"><%= t('settings.dtPort') %></dt><dd class="col-6"><%= readonly.port %></dd>
          <dt class="col-6"><%= t('settings.dtTimeout') %></dt><dd class="col-6"><%= Math.round(readonly.psTimeoutMs / 1000) %><%= t('settings.unitS') %></dd>
          <dt class="col-6"><%= t('settings.dtUploadMax') %></dt><dd class="col-6"><%= readonly.uploadMaxMb %> <%= t('settings.unitMb') %></dd>
          <dt class="col-6"><%= t('settings.dtReadMax') %></dt><dd class="col-6"><%= readonly.readMaxMb %> <%= t('settings.unitMb') %></dd>
          <dt class="col-6"><%= t('settings.dtPreviewLines') %></dt><dd class="col-6"><%= readonly.previewPageLines %> <%= t('settings.unitLines') %></dd>
          <dt class="col-6"><%= t('settings.dtExtractMax') %></dt><dd class="col-6"><%= readonly.extractMaxMb %> <%= t('settings.unitMb') %></dd>
          <dt class="col-6"><%= t('settings.dtExtractFiles') %></dt><dd class="col-6"><%= readonly.extractMaxFiles %> <%= t('settings.unitItems') %></dd>
          <dt class="col-6"><%= t('settings.dtServerOpen') %></dt>
          <dd class="col-6">
            <% if (readonly.enableServerOpen) { %><span class="badge bg-warning-lt"><%= t('settings.enabled') %></span><% } else { %><span class="badge bg-secondary-lt"><%= t('settings.disabled') %></span><% } %>
          </dd>
          <dt class="col-6"><%= t('settings.dtLogRetention') %></dt><dd class="col-6"><%= readonly.logRetentionDays %> <%= t('settings.unitDays') %></dd>
        </dl>
      </div>
      <div class="card-footer">
        <div class="small text-secondary mb-1">
          <i class="ti ti-shield-lock me-1"></i><%= t('settings.pathWhitelist') %>
          <% if (readonly.pathWhitelist.length === 0) { %>
            <span class="badge bg-secondary-lt ms-1"><%= t('settings.whitelistOff') %></span>
          <% } %>
        </div>
        <% for (const w of readonly.pathWhitelist) { %>
          <div class="small font-monospace text-break"><i class="ti ti-point me-1"></i><%= w %></div>
        <% } %>
      </div>
    </div>
  </div>
</div>
