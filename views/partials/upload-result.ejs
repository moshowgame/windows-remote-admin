<%# 上传结果 + 表格刷新（locals: uploaded, okCount, failCount，以及 browse 上下文） %>
<div class="alert alert-icon alert-info d-flex align-items-start mb-3" role="alert">
  <i class="ti ti-upload fs-2 me-2"></i>
  <div class="flex-grow-1">
    <strong>上传完成：</strong>成功 <%= okCount %> 个<%= failCount > 0 ? `，失败 ${failCount} 个` : '' %>
    <ul class="small mb-0 mt-1 ps-3">
      <% for (const r of uploaded) { %>
        <li class="<%= r.ok ? '' : 'text-danger' %>">
          <i class="ti <%= r.ok ? 'ti-circle-check text-success' : 'ti-circle-x text-danger' %> me-1"></i>
          <%= r.name %><%= r.ok ? `（${r.sizeText}）` : `：${r.note}` %>
        </li>
      <% } %>
    </ul>
  </div>
  <button type="button" class="btn btn-sm btn-ghost-secondary ms-2" onclick="document.getElementById('upload-result-region').innerHTML=''">
    <i class="ti ti-x"></i>
  </button>
</div>
<%- include('file-browse') %>
