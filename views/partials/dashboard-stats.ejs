<% /* 统计卡片片段：OS / CPU / 内存 / 运行时间 / 磁盘（10s 轮询整体刷新） */ %>
<div class="row row-cards">
  <div class="col-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">操作系统</div>
        <% if (s.ok) { %>
          <div class="h2 mb-1 text-truncate" title="<%= s.os %>"><%= s.os %></div>
          <div class="text-secondary">版本 <%= s.version %> (Build <%= s.build %>)</div>
        <% } else { %>
          <div class="h2 mb-1 text-secondary">N/A</div>
          <div class="text-secondary">采集失败或 PowerShell 不可用</div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">CPU 使用率</div>
        <div class="d-flex align-items-center mb-1">
          <div class="h2 mb-0 me-3">
            <% if (s.ok && s.cpuLoad != null) { %><%= s.cpuLoad %>%<% } else { %>N/A<% } %>
          </div>
        </div>
        <div class="progress progress-sm">
          <div class="progress-bar bg-blue" style="width: <%= (s.ok && s.cpuLoad != null) ? s.cpuLoad : 0 %>%"></div>
        </div>
        <div class="text-secondary mt-2 text-truncate" title="<%= s.cpuName || '' %>"><%= s.cpuName || '处理器信息不可用' %></div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">内存使用</div>
        <div class="d-flex align-items-center mb-1">
          <div class="h2 mb-0 me-3">
            <% if (s.ok && s.memPct != null) { %><%= s.memPct %>%<% } else { %>N/A<% } %>
          </div>
        </div>
        <div class="progress progress-sm">
          <div class="progress-bar bg-green" style="width: <%= (s.ok && s.memPct != null) ? s.memPct : 0 %>%"></div>
        </div>
        <div class="text-secondary mt-2">
          <% if (s.ok) { %><%= s.memUsedText %> / <%= s.memTotalText %><% } else { %>采集失败<% } %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">运行时间</div>
        <div class="h2 mb-1">
          <% if (s.ok) { %><%= s.uptimeText %><% } else { %>N/A<% } %>
        </div>
        <div class="text-secondary"><i class="ti ti-clock me-1"></i>自上次开机</div>
      </div>
    </div>
  </div>
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <div class="subheader mb-3">本地磁盘</div>
        <% if (s.ok && s.disks.length) { %>
          <div class="row row-cards">
            <% for (const disk of s.disks) { %>
              <div class="col-6 col-md-3">
                <div class="d-flex align-items-center mb-1">
                  <strong class="me-2"><%= disk.id %></strong>
                  <span class="text-secondary"><%= disk.usedText %> / <%= disk.totalText %></span>
                </div>
                <div class="progress progress-sm">
                  <div class="progress-bar <%= disk.pct >= 90 ? 'bg-red' : disk.pct >= 75 ? 'bg-orange' : 'bg-teal' %>" style="width: <%= disk.pct %>%"></div>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="text-secondary">N/A</div>
        <% } %>
      </div>
    </div>
  </div>
</div>
