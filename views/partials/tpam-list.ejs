<% if (cred) { %>
<div class="card border-success mb-3">
  <div class="card-header bg-success-lt">
    <h3 class="card-title text-success"><i class="ti ti-key me-2"></i><%= t('tpam.credTitle') %></h3>
  </div>
  <div class="card-body">
    <div class="row g-2">
      <div class="col-md-6">
        <label class="form-label small mb-1"><%= t('tpam.credUser') %></label>
        <div class="input-group input-group-sm">
          <input class="form-control font-monospace" readonly value="<%= cred.username %>">
          <button class="btn tpam-copy" data-value="<%= cred.username %>" type="button" title="<%= t('tpam.copy') %>"><i class="ti ti-copy"></i></button>
        </div>
      </div>
      <div class="col-md-6">
        <label class="form-label small mb-1"><%= t('tpam.credPwd') %></label>
        <div class="input-group input-group-sm">
          <input class="form-control font-monospace" readonly value="<%= cred.password %>">
          <button class="btn tpam-copy" data-value="<%= cred.password %>" type="button" title="<%= t('tpam.copy') %>"><i class="ti ti-copy"></i></button>
        </div>
      </div>
    </div>
    <div class="text-secondary small mt-2">
      <i class="ti ti-clock me-1"></i><%= t('tpam.credExpires') %> <%= cred.expiresAtStr %>
      <span class="ms-2"><i class="ti ti-alert-triangle me-1"></i><%= t('tpam.credHint') %></span>
    </div>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-users-group me-2"></i><%= t('tpam.listTitle') %></h3>
  </div>
  <div class="card-body py-2">
    <% if (!items || !items.length) { %>
    <div class="text-secondary py-1"><%= t('tpam.listEmpty') %></div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table table-sm">
        <thead>
          <tr>
            <th><%= t('tpam.colUser') %></th>
            <th><%= t('tpam.colStaff') %></th>
            <th><%= t('tpam.colCrIn') %></th>
            <th><%= t('tpam.colCreated') %></th>
            <th><%= t('tpam.colExpires') %></th>
            <th><%= t('tpam.colRemaining') %></th>
            <% if (isAdmin) { %><th class="text-end"><%= t('tpam.colActions') %></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (it) { %>
          <tr>
            <td class="font-monospace"><%= it.username %></td>
            <td><%= it.staffId %></td>
            <td class="font-monospace"><%= it.crIn %></td>
            <td class="text-secondary small"><%= it.createdAtStr %></td>
            <td class="text-secondary small"><%= it.expiresAtStr %></td>
            <td><span class="badge bg-azure-lt"><%= it.remainingStr %></span></td>
            <% if (isAdmin) { %>
            <td class="text-end">
              <button class="btn btn-sm btn-outline-danger tpam-revoke" data-user="<%= it.username %>">
                <i class="ti ti-ban me-1"></i><%= t('tpam.revoke') %>
              </button>
            </td>
            <% } %>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
