<%# 端口/网络列表片段：统计条 + 连接表（搜索/筛选/操作后整块刷新） %>
<% const fmtAddr = (a, p) => (a && String(a).includes(':')) ? ('[' + a + ']:' + p) : ((a || '-') + ':' + p); %>
<% if (msg) { %>
<div class="alert alert-danger alert-dismissible m-2 mb-0" role="alert">
  <i class="ti ti-alert-triangle me-1"></i><%= msg %>
</div>
<% } %>
<% if (truncated) { %>
<div class="alert alert-warning m-2 mb-0 py-2" role="alert">
  <i class="ti ti-alert-circle me-1"></i><%= t('net.truncated') %>
</div>
<% } %>

<div class="d-flex flex-wrap gap-2 align-items-center px-3 pt-3">
  <span class="badge bg-secondary-lt"><%= t('net.statTotal').replace('{n}', stats.total) %></span>
  <span class="badge bg-azure-lt"><%= t('net.statListen').replace('{n}', stats.listen) %></span>
  <span class="badge bg-success-lt"><%= t('net.statEstablished').replace('{n}', stats.established) %></span>
</div>

<div class="table-responsive">
  <table class="table table-hover table-vcenter card-table">
    <thead>
      <tr>
        <th style="width:6%"><%= t('net.colProto') %></th>
        <th style="width:17%"><%= t('net.colLocal') %></th>
        <th style="width:17%"><%= t('net.colRemote') %></th>
        <th style="width:11%"><%= t('net.colState') %></th>
        <th style="width:7%"><%= t('net.colPid') %></th>
        <th style="width:20%"><%= t('net.colProc') %></th>
        <% if (role !== 'readonly') { %>
        <th style="width:8%" class="text-end"><%= t('net.colActions') %></th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
      <tr><td colspan="<%= role !== 'readonly' ? 7 : 6 %>" class="text-center text-secondary py-4"><%= t('net.noRows') %></td></tr>
      <% } %>
      <% rows.forEach(function (row) {
        const stCls = row.st === 'Listen' ? 'bg-azure-lt'
          : (row.st === 'Established' ? 'bg-success-lt'
          : (row.st === 'TimeWait' || row.st === 'CloseWait' ? 'bg-warning-lt' : 'bg-secondary-lt'));
        const protectedPid = row.x === 0 || row.x === 4 || row.x === 8;
      %>
      <tr>
        <td><span class="badge <%= row.proto === 'UDP' ? 'bg-purple-lt' : 'bg-blue-lt' %>"><%= row.proto %></span></td>
        <td class="font-monospace text-truncate" title="<%= fmtAddr(row.la, row.lp) %>"><%= fmtAddr(row.la, row.lp) %></td>
        <td class="font-monospace text-truncate" title="<%= row.st === 'Listen' ? '-' : fmtAddr(row.ra, row.rp) %>"><%= row.st === 'Listen' ? '-' : fmtAddr(row.ra, row.rp) %></td>
        <td><span class="badge <%= stCls %>"><%= row.st %></span></td>
        <td class="font-monospace"><%= row.x %></td>
        <td class="small text-secondary text-truncate">
          <div class="font-monospace text-truncate" title="<%= row.pn || '' %>"><%= row.pn || '-' %></div>
          <% if (row.pc) { %>
          <div class="font-monospace text-truncate lh-1" style="font-size:.75rem" title="<%= row.pc %>"><%= row.pc %></div>
          <% } %>
        </td>
        <% if (role !== 'readonly') { %>
        <td class="text-end">
          <% if (!protectedPid) { %>
          <button type="button" class="btn btn-sm btn-outline-danger net-kill" title="<%= t('net.kill') %>"
                  data-pid="<%= row.x %>" data-pname="<%= row.pn || '' %>">
            <i class="ti ti-x"></i>
          </button>
          <% } else { %>
          <span class="text-secondary">—</span>
          <% } %>
        </td>
        <% } %>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
