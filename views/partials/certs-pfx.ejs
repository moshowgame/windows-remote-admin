<% /* pfx 导出一次性下载框（token + 密码展示） */ %>
<div class="modal show" tabindex="-1" style="display:block;">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="ti ti-package me-1"></i><%= t('certs.exportPfx') %></h5>
        <button type="button" class="btn-close" onclick="this.closest('.modal').remove()"></button>
      </div>
      <div class="modal-body small">
        <p class="mb-2"><%= t('certs.pfxNote') %></p>
        <button type="button" class="btn btn-primary w-100 certs-pfx-download" data-token="<%= token %>">
          <i class="ti ti-download me-1"></i><%= t('certs.pfxDownload') %>
        </button>
        <div class="text-secondary mt-2"><%= t('certs.tokenTtl') %></div>
      </div>
    </div>
  </div>
</div>
