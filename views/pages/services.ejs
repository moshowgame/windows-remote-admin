<%- include('../layouts/layout-top') %>

<div class="page-header d-print-none">
  <div class="container-xl">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle"><%= t('services.pretitle') %></div>
        <h2 class="page-title"><i class="ti ti-settings me-1"></i><%= t('services.title') %></h2>
        <div class="text-secondary mt-1"><%= t('services.subtitle') %></div>
      </div>
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">
    <div class="card">
      <div class="card-header py-3">
        <div class="row g-2 align-items-center w-100">
          <div class="col-md-5 col-lg-4">
            <div class="position-relative">
              <input type="search" id="svc-kw" name="kw" class="form-control form-control-sm ps-4"
                     placeholder="<%= t('services.searchPlaceholder') %>" value="<%= kw %>" autocomplete="off"
                     hx-get="/services/list" hx-target="#svc-table-region" hx-swap="innerHTML"
                     hx-trigger="input changed delay:400ms, search">
              <i class="ti ti-search position-absolute top-50 translate-middle-y ms-2 text-secondary"></i>
            </div>
          </div>
          <div class="col text-md-end small text-secondary">
            <%= t('services.listSource') %>
          </div>
        </div>
      </div>
      <div id="svc-table-region">
        <%- include('../partials/services-list', { services, kw, stats, msg }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/layout-bottom') %>
