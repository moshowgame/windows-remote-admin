<%- include('../layouts/layout-top') %>

<div class="page-header d-print-none mb-3">
  <div class="row align-items-center g-2">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-dashboard me-2"></i><%= t('dashboard.title') %></h2>
    </div>
    <div class="col-auto">
      <button class="btn btn-outline-primary" hx-get="/dashboard/stats?part=processes" hx-target="#process-table-body" hx-swap="innerHTML">
        <i class="ti ti-refresh me-1"></i><%= t('dashboard.refreshProcesses') %>
      </button>
    </div>
  </div>
</div>

<% /* 统计卡片：每 10s 轮询刷新（初次渲染由服务端直出） */ %>
<div id="stat-cards" hx-get="/dashboard/stats" hx-trigger="every 10s" hx-swap="innerHTML">
  <%- include('../partials/dashboard-stats', { s }) %>
</div>

<div class="card mt-3">
  <div class="card-header">
    <h3 class="card-title"><i class="ti ti-list-numbers me-1"></i><%= t('dashboard.topProcesses') %></h3>
  </div>
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th><%= t('dashboard.processName') %></th>
          <th class="w-1">PID</th>
          <th class="w-1 text-end"><%= t('dashboard.memory') %></th>
          <th class="w-1 text-end"><%= t('dashboard.cpuTime') %></th>
        </tr>
      </thead>
      <tbody id="process-table-body" hx-get="/dashboard/stats?part=processes" hx-trigger="load" hx-swap="innerHTML">
        <tr><td colspan="4" class="text-center text-secondary"><%= t('common.loading') %></td></tr>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/layout-bottom') %>
