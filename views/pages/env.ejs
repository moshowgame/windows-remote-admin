<%- include('../layouts/layout-top') %>

<div class="page-header d-print-none mb-2">
  <div class="row align-items-center g-2">
    <div class="col">
      <h2 class="page-title"><i class="ti ti-variable me-2"></i><%= t('env.title') %></h2>
    </div>
    <div class="col-auto text-secondary small">
      <%= t('env.restartNote') %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex flex-wrap align-items-center py-2 gap-2">
    <div class="d-flex align-items-center gap-2">
      <label class="form-label mb-0 small text-secondary" for="env-scope-filter"><%= t('env.scopeLabel') %></label>
      <select id="env-scope-filter" class="form-select form-select-sm" style="width:auto; min-width:130px;">
        <option value="Machine" <%= scope === 'Machine' ? 'selected' : '' %>><%= t('env.scopeMachine') %></option>
        <option value="User" <%= scope === 'User' ? 'selected' : '' %>><%= t('env.scopeUser') %></option>
      </select>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
      <input id="env-kw" class="form-control form-control-sm wra-search-sm" type="search"
             placeholder="<%= t('env.searchPlaceholder') %>" value="<%= kw %>" style="max-width:220px;">
      <% if (role !== 'readonly') { %>
      <button id="env-add" class="btn btn-sm btn-primary" type="button">
        <i class="ti ti-plus me-1"></i><%= t('env.add') %>
      </button>
      <% } %>
    </div>
  </div>
  <div id="env-table" hx-get="/env/list?scope=<%= scope %>&kw=<%= encodeURIComponent(kw) %>"
       hx-trigger="refresh from:body" hx-swap="innerHTML">
    <%- include('../partials/env-list', { items: items, total: total, scope: scope, kw: kw, t: t, role: role, msg: msg }) %>
  </div>
</div>

<!-- 新增/修改变量（自管理 modal） -->
<div class="modal" id="env-edit-modal" tabindex="-1" style="display:none;">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="env-edit-title"><%= t('env.add') %></h5>
        <button type="button" class="btn-close" data-env-dismiss></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label small mb-1"><%= t('env.scopeLabel') %></label>
          <select id="env-edit-scope" class="form-select form-select-sm">
            <option value="Machine"><%= t('env.scopeMachine') %></option>
            <option value="User"><%= t('env.scopeUser') %></option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label small mb-1"><%= t('env.nameLabel') %></label>
          <input id="env-edit-name" class="form-control form-control-sm font-monospace" maxlength="255"
                 autocomplete="off" spellcheck="false">
        </div>
        <div class="mb-0">
          <div class="d-flex align-items-center justify-content-between mb-1">
            <label class="form-label small mb-0"><%= t('env.valueLabel') %></label>
            <button id="env-list-edit" type="button" class="btn btn-sm btn-outline-secondary">
              <i class="ti ti-list-numbers me-1"></i><%= t('env.listEdit') %>
            </button>
          </div>
          <textarea id="env-edit-value" class="form-control form-control-sm font-monospace" rows="5"
                    maxlength="32000" spellcheck="false"></textarea>
          <div id="env-list-editor" class="d-none">
            <div id="env-list-rows" class="border rounded p-2" style="max-height:240px; overflow-y:auto;"></div>
            <div class="d-flex align-items-center justify-content-between mt-2">
              <button id="env-list-add" type="button" class="btn btn-sm btn-outline-secondary">
                <i class="ti ti-plus me-1"></i><%= t('env.listAdd') %>
              </button>
              <button id="env-list-apply" type="button" class="btn btn-sm btn-primary">
                <i class="ti ti-arrow-back-up me-1"></i><%= t('env.listApply') %>
              </button>
            </div>
          </div>
          <div id="env-view-hint" class="form-hint d-none"><%= t('env.sensMasked') %></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm" data-env-dismiss><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-sm btn-primary" id="env-edit-save"><%= t('common.save') %></button>
      </div>
    </div>
  </div>
</div>

<!-- 删除确认（预览命令） -->
<div class="modal" id="env-delete-modal" tabindex="-1" style="display:none;">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-danger"><i class="ti ti-trash me-1"></i><%= t('env.deleteTitle') %></h5>
        <button type="button" class="btn-close" data-env-dismiss></button>
      </div>
      <div class="modal-body">
        <p class="mb-2 small"><%= t('env.deleteMsg') %></p>
        <pre class="border rounded p-2 font-monospace small mb-0 bg-danger-lt">[Environment]::SetEnvironmentVariable(
  '<span id="env-del-name"></span>', $null, '<span id="env-del-scope"></span>')</pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-sm" data-env-dismiss><%= t('common.cancel') %></button>
        <button type="button" class="btn btn-sm btn-danger" id="env-del-confirm"><%= t('common.delete') %></button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var CSRF = '<%= csrf %>';
    var T = {
      saved: '<%= t("env.saved").replace("{n}", "NAME") %>',
      deleted: '<%= t("env.deleted").replace("{n}", "NAME") %>',
      actionFailed: '<%= t("env.actionFailed").replace("{n}", "") %>',
      revealErr: '<%= t("env.revealFailed") %>',
      listEdit: '<%= t("env.listEdit") %>',
      textEdit: '<%= t("env.textEdit") %>'
    };

    function toastMsg(msg, type) {
      document.body.dispatchEvent(new CustomEvent('toast', { detail: { message: msg, type: type || 'success' } }));
    }
    function refreshList() { htmx.ajax('GET', document.getElementById('env-table').getAttribute('hx-get'), '#env-table'); }

    // 自管理 modal
    function openModal(el) { el.style.display = 'block'; el.classList.add('show'); document.body.classList.add('modal-open'); }
    function closeModal(el) {
      el.style.display = 'none'; el.classList.remove('show'); document.body.classList.remove('modal-open');
      var bd = document.querySelector('.modal-backdrop'); if (bd) bd.remove();
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-env-dismiss]')) {
        var m = e.target.closest('.modal'); if (m) closeModal(m);
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') document.querySelectorAll('.modal.show').forEach(closeModal);
    });

    var editModal = document.getElementById('env-edit-modal');
    var delModal = document.getElementById('env-delete-modal');
    var currentScope = '<%= scope %>';
    var currentKw = '<%= encodeURIComponent(kw) %>';

    function listUrl(scope) { return '/env/list?scope=' + (scope || currentScope) + '&kw=' + currentKw; }

    // 作用域筛选切换（新建跟随当前筛选；已有变量作用域固定不可改）
    var scopeSel = document.getElementById('env-scope-filter');
    scopeSel.addEventListener('change', function () {
      currentScope = this.value;
      currentKw = '';
      document.getElementById('env-kw').value = '';
      document.getElementById('env-table').setAttribute('hx-get', listUrl(currentScope));
      refreshList();
    });

    // 搜索（回车触发）
    document.getElementById('env-kw').addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      currentKw = encodeURIComponent(this.value.trim());
      document.getElementById('env-table').setAttribute('hx-get', listUrl(currentScope));
      refreshList();
    });

    // 查看（所有角色可用）：复用编辑 modal 的只读模式，避免误触发编辑
    document.addEventListener('click', function (e) {
      var vbtn = e.target.closest('.env-view');
      if (!vbtn) return;
      var ta = document.getElementById('env-edit-value');
      var saveBtn = document.getElementById('env-edit-save');
      var listBtnEl = document.getElementById('env-list-edit');
      var hint = document.getElementById('env-view-hint');
      var vName = vbtn.getAttribute('data-name');
      document.getElementById('env-edit-title').textContent = '<%= t("env.viewTitle") %>';
      if (saveBtn) saveBtn.classList.add('d-none');
      if (listBtnEl) listBtnEl.classList.add('d-none');
      hint.classList.add('d-none');
      ta.disabled = true;
      ta.classList.remove('d-none');
      var editor = document.getElementById('env-list-editor');
      if (editor) editor.classList.add('d-none');
      document.getElementById('env-edit-name').value = vName;
      document.getElementById('env-edit-name').disabled = true;
      var sel = document.getElementById('env-edit-scope');
      sel.value = vbtn.getAttribute('data-scope');
      sel.disabled = true;
      sel.removeAttribute('title');
      var sens = vbtn.getAttribute('data-sens') === '1';
      if (sens && document.body.getAttribute('data-role') === 'readonly') {
        ta.value = '••••••••';
        hint.classList.remove('d-none');
      } else {
        ta.value = vbtn.getAttribute('data-val') || '';
        if (sens) { // admin：敏感值按需拉取原值
          fetch('/env/reveal?scope=' + vbtn.getAttribute('data-scope') + '&name=' + encodeURIComponent(vName), { headers: { 'x-csrf-token': CSRF } })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (j) { ta.value = j.value; })
            .catch(function () { ta.value = ''; });
        }
      }
      openModal(editModal);
    });

    // 新增
    <% if (role !== 'readonly') { %>
    // 列表编辑器：按 ; 拆分值成行（Windows 编辑器风格），回写合并回 textarea
    var valTa = document.getElementById('env-edit-value');
    var listBtn = document.getElementById('env-list-edit');
    var listEditor = document.getElementById('env-list-editor');
    var rowsBox = document.getElementById('env-list-rows');

    function addRow(v) {
      var div = document.createElement('div');
      div.className = 'input-group input-group-sm mb-1';
      div.innerHTML = '<input class="form-control font-monospace" spellcheck="false">'
        + '<button type="button" class="btn btn-outline-secondary env-row-up" title="&uarr;"><i class="ti ti-arrow-up"></i></button>'
        + '<button type="button" class="btn btn-outline-secondary env-row-down" title="&darr;"><i class="ti ti-arrow-down"></i></button>'
        + '<button type="button" class="btn btn-outline-danger env-row-del"><i class="ti ti-trash"></i></button>';
      div.querySelector('input').value = v;
      rowsBox.appendChild(div);
    }
    function resetListEditor() {
      valTa.classList.remove('d-none');
      listEditor.classList.add('d-none');
      listBtn.innerHTML = '<i class="ti ti-list-numbers me-1"></i>' + T.listEdit;
      rowsBox.innerHTML = '';
    }
    // 从查看模式恢复：显示保存/列表编辑，启用输入
    function restoreEditMode() {
      var saveBtn = document.getElementById('env-edit-save');
      if (saveBtn) saveBtn.classList.remove('d-none');
      listBtn.classList.remove('d-none');
      document.getElementById('env-view-hint').classList.add('d-none');
      valTa.disabled = false;
    }
    listBtn.addEventListener('click', function () {
      if (listEditor.classList.contains('d-none')) {
        valTa.value.split(';').map(function (s) { return s.trim(); })
          .filter(function (s) { return s.length; }).forEach(addRow);
        if (!rowsBox.children.length) addRow('');
        valTa.classList.add('d-none');
        listEditor.classList.remove('d-none');
        listBtn.innerHTML = '<i class="ti ti-pencil me-1"></i>' + T.textEdit;
      } else {
        resetListEditor();
      }
    });
    document.getElementById('env-list-add').addEventListener('click', function () {
      addRow('');
      var inputs = rowsBox.querySelectorAll('input');
      inputs[inputs.length - 1].focus();
    });
    document.getElementById('env-list-apply').addEventListener('click', function () {
      var vals = [];
      rowsBox.querySelectorAll('input').forEach(function (inp) {
        var v = inp.value.trim();
        if (v) vals.push(v);
      });
      valTa.value = vals.join(';');
      resetListEditor();
    });
    rowsBox.addEventListener('click', function (e) {
      var row = e.target.closest('.input-group');
      if (!row) return;
      if (e.target.closest('.env-row-del')) { row.remove(); return; }
      if (e.target.closest('.env-row-up') && row.previousElementSibling) row.parentNode.insertBefore(row, row.previousElementSibling);
      if (e.target.closest('.env-row-down') && row.nextElementSibling) row.parentNode.insertBefore(row.nextElementSibling, row);
    });

    document.getElementById('env-add').addEventListener('click', function () {
      document.getElementById('env-edit-title').textContent = '<%= t("env.add") %>';
      restoreEditMode();
      resetListEditor();
      document.getElementById('env-edit-name').value = '';
      document.getElementById('env-edit-name').disabled = false;
      document.getElementById('env-edit-value').value = '';
      var sel = document.getElementById('env-edit-scope');
      sel.disabled = false;
      sel.removeAttribute('title');
      sel.value = currentScope; // 新增跟随当前筛选作用域（默认系统）
      openModal(editModal);
    });

    // 编辑（事件委托：partial 刷新后仍有效；敏感值不回填 DOM，打开时按需拉取）
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.env-edit');
      if (btn) {
        document.getElementById('env-edit-title').textContent = '<%= t("env.edit") %>';
        restoreEditMode();
        resetListEditor();
        var eName = btn.getAttribute('data-name');
        document.getElementById('env-edit-name').value = eName;
        document.getElementById('env-edit-name').disabled = true;
        document.getElementById('env-edit-value').value = btn.getAttribute('data-val') || '';
        var sel = document.getElementById('env-edit-scope');
        sel.value = btn.getAttribute('data-scope');
        sel.disabled = true; // 已有变量作用域不可修改
        sel.title = '<%= t("env.scopeLocked") %>';
        openModal(editModal);
        if (btn.getAttribute('data-sens') === '1') {
          fetch('/env/reveal?scope=' + btn.getAttribute('data-scope') + '&name=' + encodeURIComponent(eName), { headers: { 'x-csrf-token': CSRF } })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (j) { document.getElementById('env-edit-value').value = j.value; })
            .catch(function () { /* 保持空值，由用户输入 */ });
        }
        return;
      }
      var del = e.target.closest('.env-del');
      if (del) {
        document.getElementById('env-del-name').textContent = del.getAttribute('data-name');
        document.getElementById('env-del-scope').textContent = del.getAttribute('data-scope');
        delModal.setAttribute('data-name', del.getAttribute('data-name'));
        delModal.setAttribute('data-scope', del.getAttribute('data-scope'));
        openModal(delModal);
        return;
      }
      var rev = e.target.closest('.env-reveal');
      if (rev) {
        var name = rev.getAttribute('data-name'), scope = rev.getAttribute('data-scope');
        fetch('/env/reveal?scope=' + scope + '&name=' + encodeURIComponent(name), { headers: { 'x-csrf-token': CSRF } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (j) {
            var cell = document.getElementById('env-cell-' + name + '-' + scope);
            if (cell) cell.textContent = j.value;
          })
          .catch(function () { toastMsg(T.revealErr, 'error'); });
      }
    });

    // 保存
    document.getElementById('env-edit-save').addEventListener('click', function () {
      var name = document.getElementById('env-edit-name').value.trim();
      var value = document.getElementById('env-edit-value').value;
      var scope = document.getElementById('env-edit-scope').value;
      var fd = new URLSearchParams({ scope: scope, name: name, value: value, kw: decodeURIComponent(currentKw) });
      fetch('/env/save', { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded', 'x-csrf-token': CSRF }, body: fd })
        .then(function (r) { return r.text().then(function (html) { return { ok: r.ok, html: html }; }); })
        .then(function (res) {
          closeModal(editModal);
          if (res.ok) {
            toastMsg(T.saved.replace('NAME', name));
            // 筛选切到目标作用域（新增跨作用域时立即可见）
            scopeSel.value = scope;
            currentScope = scope;
            document.getElementById('env-table').setAttribute('hx-get', listUrl(scope));
            refreshList();
          } else { toastMsg(T.actionFailed + ' ' + res.html.slice(0, 120), 'error'); }
        })
        .catch(function () { closeModal(editModal); toastMsg(T.actionFailed, 'error'); });
    });

    // 删除确认
    document.getElementById('env-del-confirm').addEventListener('click', function () {
      var name = delModal.getAttribute('data-name'), scope = delModal.getAttribute('data-scope');
      var fd = new URLSearchParams({ scope: scope, name: name, kw: decodeURIComponent(currentKw) });
      fetch('/env/delete', { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded', 'x-csrf-token': CSRF }, body: fd })
        .then(function (r) { return r.text().then(function (html) { return { ok: r.ok, html: html }; }); })
        .then(function (res) {
          closeModal(delModal);
          if (res.ok) { toastMsg(T.deleted.replace('NAME', name)); refreshList(); }
          else { toastMsg(T.actionFailed + ' ' + res.html.slice(0, 120), 'error'); }
        })
        .catch(function () { closeModal(delModal); toastMsg(T.actionFailed, 'error'); });
    });
    <% } %>
  });
</script>
<%- include('../layouts/layout-bottom') %>
