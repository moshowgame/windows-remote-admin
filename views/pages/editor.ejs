<%- include('../layouts/layout-top') %>

<% if (noFile) { %>
  <div class="page-header d-print-none mb-3">
    <h2 class="page-title"><i class="ti ti-pencil me-2"></i>文本编辑器</h2>
  </div>
  <div class="empty py-5">
    <div class="empty-header"><i class="ti ti-pencil fs-1"></i></div>
    <p class="empty-title">未选择文件</p>
    <p class="empty-subtitle text-secondary">从文件管理器中选择文本文件，或直接在地址栏带上 ?path= 参数打开。</p>
    <div class="empty-action">
      <a class="btn btn-primary" href="/files"><i class="ti ti-folder me-1"></i>打开文件管理器</a>
    </div>
  </div>
<% } else { %>
  <div class="page-header d-print-none mb-3">
    <div class="row align-items-center g-2">
      <div class="col">
        <h2 class="page-title"><i class="ti ti-pencil me-2"></i>文本编辑器</h2>
        <div class="text-secondary small font-monospace text-truncate" title="<%= path %>"><%= path %></div>
      </div>
      <div class="col-auto d-flex gap-2 align-items-center">
        <% if (readonly) { %><span class="badge bg-warning-lt">只读</span><% } %>
        <span class="badge bg-secondary-lt"><%= sizeText %></span>
        <span class="badge bg-secondary-lt d-none d-md-inline"><%= mtimeText %></span>
        <a class="btn btn-sm btn-outline-secondary" href="/files?path=<%= encodeURIComponent(parentDir) %>">
          <i class="ti ti-folder me-1"></i>所在目录
        </a>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-2">
      <div class="ed-wrap">
        <div id="ed-nums" class="ed-nums" aria-hidden="true"></div>
        <textarea id="ed-input" class="ed-input" name="content" spellcheck="false" autocomplete="off"
                  <%= readonly ? 'readonly' : '' %>><%= content %></textarea>
      </div>
      <div class="d-flex align-items-center gap-2 mt-2 small text-secondary">
        <span id="ed-status"></span>
        <span class="ms-auto d-none d-md-inline">Ctrl+S 保存 · 行号同步滚动</span>
      </div>
    </div>
    <div class="card-footer d-flex gap-2">
      <form id="ed-save-form" hx-post="/editor/save" hx-include="#ed-input" hx-swap="none">
        <input type="hidden" name="path" value="<%= path %>">
        <input type="hidden" name="readonly" value="<%= readonly ? '1' : '0' %>">
        <button type="submit" class="btn btn-primary btn-sm" <%= readonly ? 'disabled' : '' %>>
          <i class="ti ti-device-floppy me-1"></i>保存（自动备份）
        </button>
      </form>
      <a class="btn btn-outline-secondary btn-sm" href="/editor?path=<%= encodeURIComponent(path) %><%= readonly ? '' : '&readonly=1' %>">
        <i class="ti <%= readonly ? 'ti-pencil' : 'ti-eye-off' %> me-1"></i><%= readonly ? '切换编辑' : '切换只读' %>
      </a>
    </div>
  </div>

  <script>
    /* 编辑器交互：行号列 / 状态栏 / 脏检查 / Ctrl+S */
    (function () {
      'use strict';
      var readonly = <%= readonly ? 'true' : 'false' %>;
      var ta = document.getElementById('ed-input');
      var nums = document.getElementById('ed-nums');
      var status = document.getElementById('ed-status');
      var form = document.getElementById('ed-save-form');
      var dirty = false;

      function fmtSize(n) {
        if (n < 1024) return n + ' B';
        var u = ['KB', 'MB', 'GB'], i = 0, v = n / 1024;
        while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
        return v.toFixed(1) + ' ' + u[i];
      }

      function refresh() {
        var lines = ta.value.split('\n').length;
        var arr = [];
        for (var i = 1; i <= lines; i++) arr.push(i);
        nums.textContent = arr.join('\n');
        status.textContent = lines + ' 行 · ' + ta.value.length + ' 字符 · ' + fmtSize(new Blob([ta.value]).size);
        nums.scrollTop = ta.scrollTop;
      }

      ta.addEventListener('input', function () {
        dirty = true;
        refresh();
      });
      ta.addEventListener('scroll', function () { nums.scrollTop = ta.scrollTop; });

      window.addEventListener('beforeunload', function (e) {
        if (dirty && !readonly) { e.preventDefault(); e.returnValue = ''; }
      });

      if (form) {
        form.addEventListener('htmx:afterRequest', function (e) {
          if (e.detail.successful) {
            dirty = false;
            WRA.showToast('已保存，原文件已自动备份');
          }
        });
      }

      document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          if (!readonly && form) {
            if (form.requestSubmit) form.requestSubmit();
            else htmx.trigger(form, 'submit');
          }
        }
      });

      refresh();
    })();
  </script>
<% } %>

<%- include('../layouts/layout-bottom') %>
